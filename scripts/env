#!/usr/bin/env zsh

# Set root directory if not already set
ZKPOW_ROOT="${ZKPOW_ROOT:-${0:A:h:h}}"
export ZKPOW_ROOT

# Load environment variables from .env file if it exists and doesn't point to this file
OVERRIDE_ENV_FILE="${OVERRIDE_ENV_FILE:-$ZKPOW_ROOT/.env}"
if [[ -n "${OVERRIDE_ENV_FILE}" ]] && [[ "${OVERRIDE_ENV_FILE}" != "${0:A}" ]] && [[ -f "${OVERRIDE_ENV_FILE}" ]]; then
  source "$OVERRIDE_ENV_FILE"
fi

# Set batch parameters from command line arguments if present, falling back to
# pre-set env vars, and then default value if nothing else.
export ZKPOW_BATCH_SIZE="${ZKPOW_BATCH_SIZE:-${1:-2016}}"
export ZKPOW_BATCH_COUNT="${ZKPOW_BATCH_COUNT:-${2:-500}}"

# Build
export ZKPOW_BUILD="${ZKPOW_BUILD:-true}"
export ZKPOW_BUILD_PROFILE="${ZKPOW_BUILD_PROFILE:-release}"

# Inputs and output
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
export ZKPOW_RUN_ID="${ZKPOW_RUN_ID:-chain-${timestamp}}"
export ZKPOW_DB_PATH="${ZKPOW_DB_PATH:-$ZKPOW_ROOT/headers.db}"

export ZKPOW_OUT_DIR="${ZKPOW_OUT_DIR:-$ZKPOW_ROOT/profiling/runs/${timestamp}}"
export ZKPOW_LOG_DIR="${ZKPOW_LOG_DIR:-$ZKPOW_OUT_DIR/logs}"
# Stable root, not a per-invocation one: the run ledger in the header database
# remembers each run id's proofs, and LocalArtifactStore keys them by run id.
export ZKPOW_PROOF_STORE_DIR="${ZKPOW_PROOF_STORE_DIR:-$ZKPOW_ROOT/proof_store}"

# Rust
export RUST_LOG="${RUST_LOG:-info}"
export RUST_LOGGER="${RUST_LOGGER:-flat}"
export RUST_BACKTRACE="${RUST_BACKTRACE:-full}"

# SP1
ZKPOW_GUEST_PROFILING="${ZKPOW_GUEST_PROFILING:-}"
if [ -n "${ZKPOW_GUEST_PROFILING}" ]; then
  export ZKPOW_GUEST_PROFILING
  export TRACE_FILE="${TRACE_FILE:-trace.json}"
  export TRACE_SAMPLE_RATE="${TRACE_SAMPLE_RATE:-100}"
  export SP1_ENABLE_TOKIO_CONSOLE="${SP1_ENABLE_TOKIO_CONSOLE:-true}"
  export SP1_CORE="${SP1_CORE:-debug}"
fi
