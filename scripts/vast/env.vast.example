# =============================================================================
# Vast.ai & SP1 Prover Environment Configuration Template
#
# Copy this file to scripts/vast/env.vast (or export these in your shell):
#   cp scripts/vast/env.vast.example scripts/vast/env.vast
#
# scripts/vast/env.vast is automatically loaded by:
#   - scripts/vast/launch-instance.sh
#   - scripts/vast/monitor-progress.sh
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Remote Storage Destination (S3, Cloudflare R2, or SSH)
# -----------------------------------------------------------------------------
# Where proofs and run ledgers will be synced continuously during proving.
# Set this to your S3 bucket URI or Cloudflare R2 URI.
#
# Example AWS S3:
#   export S3_DEST="s3://my-zkpow-bucket/proofs"
#
# Example Cloudflare R2:
#   export S3_DEST="s3://my-r2-bucket/proofs"
export S3_DEST=""

# If using SSH/rsync to another machine instead of S3:
# export SSH_DEST="user@backup-server.example.com:/data/proof_store"
export SSH_DEST=""

# -----------------------------------------------------------------------------
# 2. Storage Credentials
# -----------------------------------------------------------------------------
# Option A: Amazon AWS S3
# Requires an IAM user or role with s3:PutObject, s3:GetObject, s3:ListBucket.
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_DEFAULT_REGION="us-east-1"

# Option B: Cloudflare R2 (S3-compatible, zero egress fees)
# 1. In Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token.
# 2. Grant 'Object Read & Write' permission on your bucket.
# 3. Fill in the credentials below and uncomment:
# export AWS_ACCESS_KEY_ID="<your-cloudflare-r2-access-key-id>"
# export AWS_SECRET_ACCESS_KEY="<your-cloudflare-r2-secret-access-key>"
# export AWS_ENDPOINT_URL="https://<your-account-id>.r2.cloudflarestorage.com"
# export AWS_DEFAULT_REGION="auto"

# -----------------------------------------------------------------------------
# 3. Prover Run Configuration
# -----------------------------------------------------------------------------
# Name of the proof run. If an existing run_id is supplied, the prover
# automatically resumes from the verified_height recorded in headers.db.
# Leave blank to auto-generate a timestamped ID: chain-vast-YYYYMMDDTHHMMSSZ
export ZKPOW_RUN_ID=""

# Batch size: 2,016 headers = exactly 1 Bitcoin difficulty retarget epoch.
# Mathematically optimal: single SP1 shard (2^22 cycles), no multi-shard reduction.
export ZKPOW_BATCH_SIZE=2016

# Total batches to prove in this session (500 batches * 2016 = covers all 944k headers).
export ZKPOW_BATCH_COUNT=500

# Prover backend: 'cuda' for NVIDIA GPU, 'cpu' for CPU proving, 'mock' for local tests.
export ZKPOW_PROVER_BACKEND="cuda"

# Enable resident memory tracking per batch
export ZKPOW_MEMORY_LOGGING=1

# Tracing verbosity
export RUST_LOG="info"
export RUST_BACKTRACE="1"
