# syntax=docker/dockerfile:1
# =============================================================================
# SP1 NVIDIA CUDA GPU Proving Environment for Vast.ai / RunPod / Cloud GPU
#
# Self-contained image: builds zkpow-host at image-build time, then on
# container start an entrypoint pulls headers.db from S3-compatible storage
# and supervisord runs the prover plus a background proof-sync loop.
# =============================================================================

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS builder

ARG RUST_VERSION=1.97.1
ARG ZKPOW_FEATURES=cuda

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    SP1_HOME=/root/.sp1 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cargo/bin:/root/.sp1/bin:/usr/local/cuda/bin:$PATH \
    CARGO_TARGET_DIR=/workspace/target/docker-linux-cuda

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential ca-certificates clang cmake curl file git libprotobuf-dev \
    libsqlite3-dev libssl-dev lld m4 pkg-config protobuf-compiler zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal

RUN curl -L https://sp1.succinct.xyz | bash && \
    /root/.sp1/bin/sp1up && \
    cargo prove --version

WORKDIR /workspace

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY scripts ./scripts
COPY --from=zkvm-test . /zkvm-test

RUN if [ -n "${ZKPOW_FEATURES}" ]; then \
        cargo build --release -p zkpow-host --bin zkpow-host --features "${ZKPOW_FEATURES}"; \
    else \
        cargo build --release -p zkpow-host --bin zkpow-host; \
    fi

# =============================================================================

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

LABEL maintainer="tcrypt"
LABEL description="Self-contained ZKPOW CUDA prover node (Vast.ai)"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-} \
    ZKPOW_DATA_DIR=/data \
    ZKPOW_DB_PATH=/data/headers.db \
    ZKPOW_PROOF_STORE_DIR=/data/proof_store \
    ZKPOW_PROVER_BACKEND=cuda \
    ZKPOW_BATCH_SIZE=2016 \
    ZKPOW_BATCH_COUNT=500 \
    ZKPOW_MEMORY_LOGGING=1 \
    RUST_LOG=info \
    RUST_BACKTRACE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    awscli ca-certificates curl jq libsqlite3-0 libssl3 procps rsync sqlite3 \
    supervisor zstd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/target/docker-linux-cuda/release/zkpow-host /usr/local/bin/zkpow-host
COPY scripts/vast/sync-proofs.sh /opt/zkpow/scripts/vast/sync-proofs.sh
COPY docker/entrypoint.sh docker/run-prover.sh docker/sync-loop.sh /opt/zkpow/docker/
COPY docker/supervisord.conf /etc/supervisor/supervisord.conf
COPY docker/vast-cuda-check /usr/local/bin/vast-cuda-check

RUN chmod +x /usr/local/bin/zkpow-host /usr/local/bin/vast-cuda-check \
    /opt/zkpow/docker/*.sh /opt/zkpow/scripts/vast/sync-proofs.sh \
    && mkdir -p /data /var/log/supervisor

VOLUME ["/data"]

ENTRYPOINT ["/opt/zkpow/docker/entrypoint.sh"]
