# syntax=docker/dockerfile:1
# =============================================================================
# SP1 NVIDIA CUDA GPU Proving Environment for Vast.ai / RunPod / Cloud GPU
#
# Self-contained image: builds zkpow-host at image-build time, then on
# container start an entrypoint pulls headers.db from S3-compatible storage
# and supervisord runs the prover plus a background proof-sync loop.
# =============================================================================

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS platform

ARG RUST_VERSION=1.97.1
ARG ZKPOW_FEATURES=cuda

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    SP1_HOME=/root/.sp1 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cargo/bin:/root/.sp1/bin:/usr/local/cuda/bin:$PATH \
    CARGO_TARGET_DIR=/workspace/target/docker-linux-cuda \
    CURL_HOME=/etc/curl

COPY --chmod=0644 <<EOF ${CURL_HOME}/.curlrc
--retry-connrefused
--connect-timeout 15
--retry 5
--max-time 300
EOF

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential ca-certificates clang cmake curl file git libprotobuf-dev \
    libsqlite3-dev libssl-dev lld m4 pkg-config protobuf-compiler zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 --location -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal
RUN curl -L https://sp1.succinct.xyz | bash && \
    /root/.sp1/bin/sp1up && \
    cargo prove --version

FROM platform AS builder

WORKDIR /workspace

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY --from=zkvm-test Cargo.toml Cargo.lock /zkvm-test/
COPY --from=zkvm-test crates /zkvm-test/crates/

RUN --mount=type=cache,target=/workspace/target,id=cargo-target \\
--mount=type=cache,target=/usr/local/cargo/git/db,id=cargo-git \
--mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry \
if [ -n "${ZKPOW_FEATURES}" ]; then \
        cargo build --release -p zkpow-host --bin zkpow-host --features "${ZKPOW_FEATURES}"; \
    else \
        cargo build --release -p zkpow-host --bin zkpow-host; \
    fi \
    && cp /workspace/target/docker-linux-cuda/release/zkpow-host /usr/local/bin/zkpow-host

# =============================================================================

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

LABEL maintainer="tcrypt"
LABEL description="Self-contained ZKPOW CUDA prover node (Vast.ai)"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    awscli ca-certificates curl jq libsqlite3-0 libssl3 procps rsync sqlite3 \
    supervisor zstd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/zkpow-host /usr/local/bin/zkpow-host
COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/supervisord.conf /etc/supervisor/supervisord.conf

RUN chmod +x /usr/local/bin/zkpow-host /entrypoint.sh \
	&& mkdir -p /data

VOLUME ["/data"]

ENTRYPOINT ["/entrypoint.sh"]
