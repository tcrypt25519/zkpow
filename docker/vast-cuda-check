#!/usr/bin/env bash
set -eo pipefail

echo "============================================================"
echo " SP1 CUDA Proving Environment Diagnostics"
echo "============================================================"
echo "Architecture : $(uname -m)"
echo "OS           : $(uname -s)"
echo "zkpow-host   : $(test -x /usr/local/bin/zkpow-host && echo present || echo MISSING)"

if command -v nvidia-smi >/dev/null 2>&1; then
    echo "---------------- NVIDIA GPU Detected -----------------"
    nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
else
    echo "[!] WARNING: nvidia-smi not found. Ensure container was run with --gpus all."
fi

SHM_KB=$(df -k /dev/shm 2>/dev/null | awk 'NR==2 {print $2}' || echo 0)
SHM_HUMAN=$(df -h /dev/shm 2>/dev/null | awk 'NR==2 {print $2}' || echo 'unknown')
echo "Shared Memory: /dev/shm = $SHM_HUMAN"
if [ "$SHM_KB" -lt 4194304 ]; then
    echo "[!] CAUTION: /dev/shm is under 4 GiB ($SHM_HUMAN). For multi-shard or large batches, run docker with --shm-size=16g or --ipc=host."
else
    echo "[+] Shared memory size adequate: $SHM_HUMAN."
fi
echo "============================================================"
