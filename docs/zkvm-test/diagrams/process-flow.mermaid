flowchart TD
    CMD["cargo zkvm test [OPTIONS]<br/>(alias: cargo zkvm-test)"] --> CHECK_PKG{"Target Check:<br/>--host flag OR<br/>host-only package?"}

    %% Branch 1: Host Native
    HOST_COMPILE["cargo test --no-run (Host toolchain)"]
    CHECK_PKG -- Yes --> HOST_COMPILE
    HOST_COMPILE --> HOST_RUN["Execute Host Test Binary<br/>target/debug/deps/...<br/>(Bare Metal Native CPU)"]

    %% Branch 2: zkVM Target
    CHECK_PKG -- No --> ZKVM_COMPILE["cargo +succinct test --no-run<br/>--target riscv64im-succinct-zkvm-elf"]
    ZKVM_COMPILE --> RUNNER["cargo-zkvm Runner Orchestrator"]
    
    RUNNER --> DETECT{"sp1-core-executor build detection:<br/>OS == Linux AND Arch == x86_64 AND<br/>not(profiling) AND not(mprotect)?"}

    %% Branch 2A: Portable Interpreter (Your Mac)
    DETECT -- "No (macOS / Apple Silicon / profiling on)" --> PORTABLE["sp1_use_portable_executor<br/>(crates/core/runner/src/portable.rs)"]
    PORTABLE --> INTERPRETER["MinimalExecutorEnum<br/>Software RISC-V Interpreter<br/>(Instruction-by-instruction emulation)"]

    %% Branch 2B: Native JIT (x86_64 Linux CI/Prover)
    DETECT -- "Yes (x86_64 Linux)" --> NATIVE["sp1_use_native_executor<br/>(crates/core/runner/src/native.rs)"]
    NATIVE --> SPAWN_CHILD["Extract & Spawn Child Process<br/>/tmp/sp1-native-runner-bin-<HASH>"]
    SPAWN_CHILD --> JIT["sp1-jit: Transpile RISC-V to x86_64 Assembly"]
    JIT --> SHM["Zero-Copy /dev/shm Trace Ring<br/>+ 100ms RSS Memory Watchdog"]

    %% Output Mode
    INTERPRETER --> PROVER_MODE{"Prover Mode?"}
    SHM --> PROVER_MODE

    PROVER_MODE -- "--prover mock (default)" --> MOCK_OUT["Extract Cycles, Exit Code & Public Values<br/>Skip STARK proof"]
    PROVER_MODE -- "--prover cpu / --mode core" --> CPU_PROVER["CPU STARK Prover (Build FRI & STARK proofs)"]
    PROVER_MODE -- "--prover cuda" --> CUDA_PROVER["GPU STARK Prover (CUDA NTT / MSM acceleration)"]
