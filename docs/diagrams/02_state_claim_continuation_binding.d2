## Diagram 2: State, Claim, and Continuation — Cryptographic Binding
## (commit 6a3cfc4)
##
## The stdin wire carries the verifier-key digest plus the private State
## witness. For recursive batches, the guest derives the prior Claim and
## ContinuationData from State, reconstructs the prior MinimalPublicValues,
## and verifies the proof against that public-values hash.

direction: right

classes: {
  public_data: {
    style.fill: "#E3F2FD"
    style.stroke: "#1565C0"
    style.stroke-width: 2
  }
  private_data: {
    style.fill: "#FFF9C4"
    style.stroke: "#F57F17"
    style.stroke-width: 2
  }
  crypto: {
    shape: hexagon
    style.fill: "#FCE4EC"
    style.stroke: "#880E4F"
    style.stroke-width: 2
  }
  check: {
    shape: diamond
    style.fill: "#F3E5F5"
    style.stroke: "#4A148C"
  }
  ok: {
    style.fill: "#E8F5E9"
    style.stroke: "#1B5E20"
    style.stroke-width: 2
  }
  reject: {
    style.fill: "#FFEBEE"
    style.stroke: "#B71C1C"
    style.stroke-width: 2
  }
}

# ── Data structures ──────────────────────────────────────────────────────────

structs: Data Structures {
  state: State (full, 152 B) {
    class: private_data
    tooltip: |
      All fields needed to validate the next header:
        genesis_hash, block_hash, height, chain_work  ← public
        current_nbits,
        epoch_start_timestamp, timestamps[11]         ← private
    |
  }

  claim: Claim (100 B) {
    class: public_data
    tooltip: |
      genesis_hash  32 B
      tip_hash      32 B
      chain_work    32 B  (u256 LE)
      height         4 B
    |
  }

  continuation: ContinuationData (52 B) {
    class: private_data
    tooltip: |
      current_nbits           4 B
      epoch_start_timestamp   4 B
      timestamps[11]         44 B
    |
  }

  state -> claim: public_claim()
  state -> continuation: continuation_bytes()
}

# ── Wire protocol ─────────────────────────────────────────────────────────────

wire: Wire Protocol (stdin) {
  pcs_wire: "stdin[0]: ProofCarryingState" {
    class: public_data
    shape: queue
    tooltip: |
      Verifier-key digest only.
      Size: PROOF_CARRYING_STATE_SIZE (32 B)
    |
  }

  state_wire: "stdin[1]: State witness" {
    class: private_data
    shape: queue
    tooltip: |
      PRIVATE — auxiliary witness, not part of
      the public input envelope.
      Size: STATE_SIZE (152 B)
    |
  }

  proof_wire: "stdin proof witness if state.height > 0" {
    class: private_data
    shape: queue
    tooltip: |
      Compressed SP1 proof witness is streamed with write_proof.
      No public-values digest or claim is duplicated in stdin.
    |
  }
}

# ── Guest execution ───────────────────────────────────────────────────────────

guest: Guest (zkVM) {
  parse_pcs: Parse ProofCarryingState {
    shape: hexagon
    style.fill: "#E3F2FD"
  }

  parse_state: Parse State Witness {
    shape: hexagon
    style.fill: "#FFF9C4"
  }

  derive_claim: State::public_claim() {
    class: crypto
    tooltip: Derives prior claim from authenticated state witness
  }

  derive_continuation: State::continuation_bytes() {
    class: crypto
    tooltip: Serializes the continuation digest preimage
  }

  height_check: state.height > 0? {
    class: check
  }

  verify_recursive: verify_sp1_proof(vk, hash(MinimalPV)) {
    class: crypto
    tooltip: |
      Reconstructs prior proof's MinimalPublicValues
      from (claim, continuation_digest, verifier_key).
      Tampered continuation bytes → wrong public-values hash → REJECT.
    |
  }

  apply: Apply Headers {
    class: ok
    tooltip: Uses full State (with private fields) to validate next batch
  }

  commit: Commit MinimalPublicValues {
    class: ok
    tooltip: |
      Includes new continuation_digest =
      SHA256(ContinuationData bytes)
      so the next batch can verify this one.
    |
  }

  reject: PANIC / Halt {
    class: reject
  }

  parse_pcs -> verify_recursive: verifier key
  parse_state -> derive_claim
  parse_state -> derive_continuation
  parse_state -> height_check
  height_check -> verify_recursive: yes
  height_check -> apply: no (genesis batch)
  derive_claim -> verify_recursive
  derive_continuation -> verify_recursive
  verify_recursive -> apply: proof valid ✓
  verify_recursive -> reject: digest mismatch ✗
  apply -> commit
}

# ── Cryptographic chain ───────────────────────────────────────────────────────

crypto_chain: Cryptographic Binding Chain {
  digest_n: continuation_digest(N) {
    class: crypto
    tooltip: SHA256(ContinuationData_N bytes) — in proof N public values
  }

  pv_n: MinimalPublicValues(N) {
    class: public_data
    tooltip: Committed on-chain / in recursive proof
  }

  witness_n1: State Witness(N+1) {
    class: private_data
    tooltip: |
      Supplied by prover for batch N+1.
      Contains Claim fields plus ContinuationData fields.
    |
  }

  recompute: SHA256(witness continuation bytes) {
    class: crypto
    tooltip: Guest recomputes digest from witness
  }

  compare: digest matches pv_n? {
    class: check
  }

  accept: Proceed with validation {
    class: ok
  }

  tamper_reject: REJECT — tampered witness {
    class: reject
  }

  digest_n -> pv_n: embedded in
  pv_n -> compare: expected digest
  witness_n1 -> recompute: private fields
  recompute -> compare: computed digest
  compare -> accept: equal ✓
  compare -> tamper_reject: not equal ✗
}

# ── Wire connections ──────────────────────────────────────────────────────────

wire.pcs_wire -> guest.parse_pcs
wire.state_wire -> guest.parse_state
wire.proof_wire -> guest.verify_recursive

note: |md
  **Current recursive input binding**

  `ProofCarryingState` carries only the verifier-key digest. The full `State`
  remains a private witness. The guest derives the prior `Claim` and
  `ContinuationData` from `State`.

  For recursive batches, `ContinuationData` is hashed, folded into reconstructed
  `MinimalPublicValues`, and verified against the supplied proof. Tampering the
  private continuation witness changes the public-values hash and is rejected.
| {
  shape: text
  near: "bottom-center"
  style.font-size: 13
}
